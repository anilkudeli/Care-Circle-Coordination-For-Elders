MONGODB_URI=mongodb://127.0.0.1:27017/carecircle
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
INACTIVITY_THRESHOLD_HOURS=8
# Optional STUN/TURN settings; TURN credentials use Coturn shared-secret (REST) authentication.
STUN_URL=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional: set true for implicit TLS. Port 465 enables it by default.
SMTP_SECURE=false
